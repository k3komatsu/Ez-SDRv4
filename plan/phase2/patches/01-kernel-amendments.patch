+        Some(v) => v.as_u64().filter(|n| *n <= 1u64 << 62).ok_or_else(|| SpecError::Structural {
+            reason: format!("MA-41: ezsdr.time.start_lead_ns must be an integer in 0..=2^62, not {v}"),
+        }),
+    }
+}
