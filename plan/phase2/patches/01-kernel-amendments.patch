+#[test]
+fn sb_07_coerce_refuses_a_combination() {
+    // KA-5: every key is satisfied directly — count 2 and grid 40 are both declared —
+    // and the Provider still refuses the pair, which is Vision §13 rule 1's
+    // PerformanceEnvelope refusal at validate().
+    let pair = |grid: f64| {
+        spec_with(
+            [(
+                id("radio"),
+                resource(
+                    "test.device",
+                    &[
+                        ("test.count", Constraint::Eq { value: Value::Int(2) }),
+                        ("test.grid", Constraint::Eq { value: Value::Num(grid) }),
+                    ],
+                ),
+            )]
+            .into_iter()
+            .collect(),
+        )
+    };
+    let fx = Fixture::new();
+    let p = TestProvider::new("radio", 2).with_joint_limit(50.0);
+    let providers = one_provider("radio", &p);
+    let result = validate(&pair(40.0), &profile_binding(&["radio"]), &fx.inputs(&providers))
+        .expect("validates");
+    assert_eq!(p.coerce_calls.load(std::sync::atomic::Ordering::Relaxed), 1, "coerce is called");
+    assert!(!result.is_admitted());
+    assert_eq!(result.rejected.len(), 1, "{:?}", result.rejected);
+    assert_eq!(result.rejected[0].key, key("test.grid"));
+    assert!(result.rejected[0].reason.contains("joint limit"), "the Provider's reason");
+    // Inside the limit, the same pair is admitted.
+    let ok = validate(&pair(20.0), &profile_binding(&["radio"]), &fx.inputs(&providers))
+        .expect("validates");
+    assert!(ok.is_admitted(), "{ok:?}");
