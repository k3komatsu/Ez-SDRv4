{
  "$defs": {
    "EventKind": {
      "description": "What kind of event this is, matching `^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$`:\nevery kind is namespaced. The Kernel owns the five of RS-28, under `ezsdr.`, and\nevery other kind belongs to the Vocabulary or Module that emits it.\n\nRule: SB-1, RS-27.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Why a Run stopped (RS-3, RS-23, RS-26).",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "The client asked (RS-3).",
      "properties": {
        "kind": {
          "const": "client",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "An `Attached` Lease's client went away (RS-23).",
      "properties": {
        "kind": {
          "const": "client_disconnect",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "A `Detached` Lease's TTL ran out (RS-23).",
      "properties": {
        "kind": {
          "const": "lease_expiry",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The Policy table reacted to an event (RS-26).",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventKind",
          "description": "Which event kind triggered it."
        },
        "kind": {
          "const": "policy",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Something aborted the Run (RS-9).",
      "properties": {
        "kind": {
          "const": "abort",
          "type": "string"
        },
        "message": {
          "description": "Why, uninterpreted.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  ],
  "title": "StopCause"
}
