{
  "$defs": {
    "Constraint": {
      "description": "What a Spec requires of a key. Its value is a [`Scalar`]: a constraint over a\nlist or a map cannot be written, because the matcher would then need the\nVocabulary's semantics to compare them.\n\nRule: SB-5, decision B1.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exactly this value.",
          "properties": {
            "kind": {
              "const": "eq",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Scalar",
              "description": "The value."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Within these bounds, either of which may be absent.",
          "properties": {
            "kind": {
              "const": "range",
              "type": "string"
            },
            "max": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Scalar"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Upper bound, inclusive."
            },
            "min": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Scalar"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lower bound, inclusive."
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Any of these values.",
          "properties": {
            "kind": {
              "const": "set",
              "type": "string"
            },
            "values": {
              "description": "The permitted values.",
              "items": {
                "$ref": "#/$defs/Scalar"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "At least this value.",
          "properties": {
            "kind": {
              "const": "min",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Scalar",
              "description": "The lower bound."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "At most this value.",
          "properties": {
            "kind": {
              "const": "max",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Scalar",
              "description": "The upper bound."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The key is declared at all.",
          "properties": {
            "kind": {
              "const": "present",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "Finite": {
      "description": "A finite 64-bit float: NaN and the infinities are refused, so OV-15's\ncanonicaliser never meets one.\n\nRule: SB-4, OV-15.",
      "format": "double",
      "type": "number"
    },
    "NodeId": {
      "description": "A node in the (future) multi-host deployment. `0` (the local node) is the only legal value in v4.0.\n\nRule: X7 (`00-overview.md`); it qualifies every id of TM-11, SC-6, SB-3 and MA-38.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "ResourceId": {
      "additionalProperties": false,
      "description": "Names a resource, or a sub-resource, inside the composite tree a Provider declares.\n\nThe path is a non-empty sequence of segments matching\n`^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+){0,15}$`, at most 256 bytes; `dev0/rx/0` names\nchannel 0 of the receive sub-tree of `dev0`. Vision §49 asks only for the node qualification; the\npath replaces §49's flat `local` because a channel or a timekeeper must be\naddressable (`00-overview.md` \"Where these specs depart from the Vision\").\n\nRule: SB-1, SB-3, SB-33, SB-34 (`03-spec-and-binding.md`), X7.",
      "properties": {
        "node": {
          "$ref": "#/$defs/NodeId",
          "description": "Owning node; `0`, the local node, throughout v4.0 (X7)."
        },
        "path": {
          "description": "Slash-joined path through the composite resource tree (SB-34).",
          "type": "string"
        }
      },
      "required": [
        "node",
        "path"
      ],
      "type": "object"
    },
    "Scalar": {
      "anyOf": [
        {
          "description": "A boolean.",
          "type": "boolean"
        },
        {
          "description": "A signed 64-bit integer, written as an exact decimal by the canonicaliser (OV-15).",
          "format": "int64",
          "type": "integer"
        },
        {
          "$ref": "#/$defs/Finite",
          "description": "A finite float (OV-15)."
        },
        {
          "description": "A string.",
          "type": "string"
        }
      ],
      "description": "The one scalar type: a `Value`'s scalar, a constraint's and a capability's value,\nand a `DataContract` attribute (SB-4, SB-5, SC-2).\n\nCarries no tag (OV-13's carve-out): a scalar is the value an author wrote, not a\ntwo-field object wrapping it.\n\nRule: SB-4, SB-6, SC-2."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a Provider was asked for; the input to `coerce` and the same input\n`prepare` sees (SB-7, MA-11).",
  "properties": {
    "constraints": {
      "additionalProperties": {
        "$ref": "#/$defs/Constraint"
      },
      "description": "What was asked of it (SB-5).",
      "type": "object"
    },
    "resource": {
      "$ref": "#/$defs/ResourceId",
      "description": "Which node of the tree (SB-34)."
    }
  },
  "required": [
    "resource",
    "constraints"
  ],
  "title": "Requested",
  "type": "object"
}
